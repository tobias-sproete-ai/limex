{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "limex-sfh-fuzzi-repo-capsule-receipt-v1.schema.json",
  "title": "LIMEX SFH FUZZI repository capsule receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "created_at_utc",
    "status",
    "component",
    "scope",
    "repo_integration",
    "successor_precheck",
    "reference_runtime",
    "software_stress_result",
    "hold_release_result",
    "independent_reaudit",
    "payload_hashes",
    "self_exclusion",
    "non_implications",
    "next_gate"
  ],
  "properties": {
    "$schema": { "const": "./schemas/limex-sfh-fuzzi-repo-capsule-receipt-v1.schema.json" },
    "schema_version": { "const": "limex-sfh-fuzzi-repo-capsule-receipt-v1.0.0" },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "minLength": 1 },
    "component": { "const": "components/sfh-fuzzi" },
    "scope": { "const": "SOFTWARE_FUNCTIONAL_CORE_AND_REFERENCE_HOLD_RELEASE_ADAPTER_ONLY" },
    "repo_integration": { "$ref": "#/$defs/repoIntegration" },
    "successor_precheck": { "$ref": "#/$defs/successorPrecheck" },
    "reference_runtime": { "$ref": "#/$defs/runtime" },
    "software_stress_result": { "$ref": "#/$defs/testResult" },
    "hold_release_result": { "$ref": "#/$defs/testResult" },
    "independent_reaudit": { "$ref": "#/$defs/reaudit" },
    "payload_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pathHash" }
    },
    "self_exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["excluded_from_payload_hashes", "reason"],
      "properties": {
        "excluded_from_payload_hashes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "reason": { "const": "PREVENT_SELF_REFERENTIAL_HASH_CYCLE" }
      }
    },
    "non_implications": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "next_gate": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "pathHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^[^/].+" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "repoIntegration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_sha256", "target_repository", "target_ref", "target_component_path", "status"],
      "properties": {
        "contract_sha256": { "$ref": "#/$defs/sha256" },
        "target_repository": { "type": "string", "format": "uri" },
        "target_ref": { "const": "refs/heads/main" },
        "target_component_path": { "const": "components/sfh-fuzzi" },
        "status": { "type": "string", "minLength": 1 }
      }
    },
    "successorPrecheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_visibility", "commands", "native_checks", "candidate_full_tree_sha256", "candidate_runtime_identity", "private_command_capture_sha256", "private_native_validator_report_sha256"],
      "properties": {
        "status": { "const": "PASS" },
        "evidence_visibility": { "const": "PRIVATE_UPSTREAM_NOT_REPRODUCIBLE_FROM_PUBLIC_CAPSULE" },
        "commands": { "type": "integer", "minimum": 1 },
        "native_checks": { "type": "integer", "minimum": 1 },
        "candidate_full_tree_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_runtime_identity": { "type": "string", "pattern": "^LIMEX_TREE_SHA256_[0-9a-f]{64}$" },
        "private_command_capture_sha256": { "$ref": "#/$defs/sha256" },
        "private_native_validator_report_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "node_version", "node_executable_sha256", "network_boundary_attestation"],
      "properties": {
        "platform": { "const": "darwin_arm64" },
        "node_version": { "const": "v24.13.1" },
        "node_executable_sha256": { "$ref": "#/$defs/sha256" },
        "network_boundary_attestation": { "const": "NOT_ATTESTED_BY_JAVASCRIPT_HARNESSES" }
      }
    },
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "runs", "passed", "failed", "assertions", "result_sha256"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "runs": { "type": "integer", "minimum": 1 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "assertions": { "type": "integer", "minimum": 1 },
        "result_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "reaudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "auditor_count", "reports"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "auditor_count": { "type": "integer", "minimum": 0 },
        "reports": { "type": "array", "items": { "$ref": "#/$defs/pathHash" }, "uniqueItems": true }
      }
    }
  }
}
