{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:limex:schema:llm-execution-attestation:v1",
  "title": "LIMEX LLM execution attestation V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tenant",
    "event_id",
    "measurement",
    "epoch",
    "unit",
    "quantity",
    "event_time",
    "execution_receipt_sha256",
    "custody_receipt_sha256",
    "producer_runtime_sha256",
    "evidence_class"
  ],
  "properties": {
    "schema": {"const": "LIMEX_LLM_EXECUTION_ATTESTATION_V1"},
    "tenant": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "event_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "measurement": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "epoch": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "unit": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "quantity": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "event_time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "execution_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "custody_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "producer_runtime_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_class": {"const": "UNATTESTED_REFERENCE"}
  },
  "x-limex-authority": {
    "direction": "LIMEX_LLM_TO_LIMEX_SETTLE_ONLY",
    "creates_execution_authority": false,
    "financial_feedback_to_llm": "DENY",
    "external_effect": "DENY"
  }
}
